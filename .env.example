APP_NAME=search_opt
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1
SCHEMA_VERSION=1.0.0
API_KEY_HEADER_NAME=X-API-Key
API_KEYS=REPLACE_WITH_LOCAL_API_KEY
AUTH_ENABLED=false
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BYTES=1048576
MAX_AUDIO_UPLOAD_BYTES=5242880
SAFE_ERROR_MODE=true
BOOTSTRAP_SAMPLE_DATA=false
SAMPLE_DATA_PATH=sample_data/courses.json
SEARCH_BACKEND=opensearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=sphere-courses-v1
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_TIMEOUT_SECONDS=10
ENABLE_SEMANTIC_SEARCH=true
SEMANTIC_MODEL_ALLOW_DOWNLOAD=false
ENABLE_INDIC_TRANSLITERATION=true
ENABLE_DEBUG_PAYLOADS=false
STT_PROVIDER=mock
VOICE_MOCK_ENABLED=true
WHISPER_MODEL_NAME=tiny
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=.cache/whisper
WHISPER_LANGUAGE=
ANALYTICS_ENABLED=true
ANALYTICS_DB_PATH=data/analytics.db
MAX_QUERY_LENGTH=240
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=25
SPHERE_PUBLIC_SEARCH_URL=https://sphere.aastrika.org/apis/public/v8/publicContent/v1/search
# Node UI proxy configuration (applied in the upstream repository):
ADVANCED_SEARCH_ENABLED=false
ADVANCED_SEARCH_URL=http://127.0.0.1:8000/v1/search
ADVANCED_SEARCH_TIMEOUT_MS=3000
AUTOCORRECT_CONFIDENCE_THRESHOLD=0.90
SHOW_RESULTS_FOR_CONFIDENCE_THRESHOLD=0.96
DID_YOU_MEAN_SIMILARITY_CEILING=0.985
MIN_CANDIDATE_SCORE=0.35
SEMANTIC_RESCUE_THRESHOLD=0.28
FUZZY_RESCUE_THRESHOLD=0.78
